# ---------------------------------------------------------------- Bridge
# Lokaal zonder geheimen werken: alleen met deze vlag, en alleen buiten een
# productiebuild. Zonder de vlag weigert elk endpoint waarvan het geheim
# ontbreekt, en geeft het dashboard 503. In productie telt hij nooit.
BRIDGE_DEV_NO_AUTH=true

# Gedeeld geheim dat de Zipchat custom tool meestuurt (header X-Bridge-Secret).
# Productie: verplicht, minstens 16 tekens, anders start de bridge niet. Dat
# geldt ook voor CM_WEBHOOK_SECRET, en ADMIN_SSO_SECRET (minstens 32).
BRIDGE_SHARED_SECRET=

# Zet op "true" om externe calls te simuleren, "false" om te forceren dat ze
# echt gaan. Weglaten = automatisch: mock zolang credentials ontbreken.
BRIDGE_MOCK_MODE=

# ---------------------------------------------------------------- Zipchat
# Account > Settings > API access. User-token begint met zcu-, chat-token met zc-.
ZIPCHAT_API_TOKEN=
# Op te halen via GET /chats met bovenstaand token.
ZIPCHAT_CHAT_ID=
# Zipchat-gebruiker waaronder MSC-antwoorden in de widget verschijnen.
ZIPCHAT_SENDER_ID=

# ---------------------------------------------------------------- CM.com
# technicalLinkId uit de TwoWay-adapter-URL.
CM_ACCOUNT_ID=
# Meestal gelijk aan CM_ACCOUNT_ID; alleen zetten als routing control afwijkt.
CM_LOGICAL_ACCOUNT_ID=
# adapterId uit de TwoWay-adapter-URL.
CM_ADAPTER_ID=
# CM product token (header X-CM-PRODUCTTOKEN), rechten:
# ConversationalRouter.RouterSession_Update
CM_PRODUCT_TOKEN=
# Robin-webshop van een live chat (WebStoreReferrer). Standaard HALO = webshop
# "HALO Livechat", waar ook de chats van Tobi binnenkomen. Zonder live chat is
# het de URL van de webshop van het land.
CM_WEBSTORE_REFERRER=
# Zonder live chat: "cm" (standaard) via de router, zoals HALO; "robin" als
# Online-gesprek (contactformulier). Dat laatste is ook de terugval.
ESCALATION_TARGET=
# stateNameId van de state die naar een agent in Agent Inbox routeert.
CM_AGENT_STATE_NAME_ID=
# Optioneel: state om terug naar de bot te routeren.
CM_BOT_STATE_NAME_ID=
# Kanaalnaam in het TwoWay chat-object voor webchat.
CM_CHANNEL=Custom
# Geheim dat CM meestuurt op de webhook (header X-Bridge-Token). Zet dit in CM
# bij zowel het Message Endpoint als het Hand Over Endpoint via 'Add header'.
CM_WEBHOOK_SECRET=
# Op 'true' zetten om de klant actief te melden dat er is doorverbonden.
# Standaard uit: doe dit pas als je zeker weet dat de handover altijd wordt opgepakt.
CM_HANDOVER_NOTIFY_CUSTOMER=false

# ---------------------------------------------------------------- Marketing
# Samenwerkingsaanvragen van de social-media-agent; gaan niet via CM/Robin.
MARKETING_EMAIL_TO=marketing@dutchtoysgroup.com
# Microsoft Graph (app-registratie "Marketing Dashboard", Mail.Send).
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Mailbox waaruit verstuurd wordt.
MS_GRAPH_SENDER=

# ---------------------------------------------------------------- E-mailcode
# Bestellingen opzoeken met alleen een e-mailadres (README, Bestellingen met
# een e-mailcode). Eigen Entra-app "Zipchat noreply": mag via Exchange RBAC
# alleen vanuit noreply@exittoys.com versturen. Geheim 24 maanden geldig.
VERIFY_GRAPH_TENANT_ID=
VERIFY_GRAPH_CLIENT_ID=
VERIFY_GRAPH_CLIENT_SECRET=
# Standaard noreply@exittoys.com.
VERIFY_MAIL_FROM=
# Order-API's van de webshop (Dicode); dezelfde headers als HALO-tools 16 en 26.
EXIT_ORDER_API_AUTH=
EXIT_TRACKING_API_AUTH=

# ---------------------------------------------------------------- Opslag
# Postgres connection string. Leeg = in-memory (alleen lokaal bruikbaar).
# Productie: postgresql://dtg-zipchat-cm-bridge-weu@dtg-data-platform-pg.postgres.database.azure.com:5432/dtg_data
DATABASE_URL=
# "entra" = wachtwoord is een token van de managed identity (productie).
DATABASE_AUTH=
# search_path; productie: app_zipchat_bridge.
DATABASE_SCHEMA=
# Vaste publieke URL voor de zelfaanroep van /api/poll.
BRIDGE_PUBLIC_URL=

# ---------------------------------------------------------------- Polling
POLL_WINDOW_MS=50000
POLL_INTERVAL_MS=5000
POLL_IDLE_TIMEOUT_MIN=60

# Bearer-token waarmee de Logic App /api/poll aanroept. Leeg = BRIDGE_SHARED_SECRET.
CRON_SECRET=

# Aanmelden op het dashboard via admin (README, Aanmelden en toegang).
# Zelfde waarde als SSO_ZIPCHAT_SECRET op admin; minstens 32 tekens.
ADMIN_SSO_SECRET=
# Marketing-account-id's die altijd toegang hebben, kommagescheiden.
VASTE_TOEGANG=
# Het vaste adres van het dashboard en van admin. Lokaal bijv.
# DASHBOARD_URL=http://localhost:3000; standaard de productieadressen.
DASHBOARD_URL=
ADMIN_URL=

# Laat een lopend gesprek zichzelf doorpollen in plaats van te wachten op de
# cron (vangnet, elke 5 min). "false" zet dit uit; verhoog dan de frequentie
# van de Logic App.
POLL_SELF_CHAIN=true
